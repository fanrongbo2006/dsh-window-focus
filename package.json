{
  "name": "dsh-window-focus",
  "version": "1.1.8",
  "description": "审批通知可直接「允许一次/拒绝」，点击通知把 DeepSeek Harness 桌面窗口带到前台。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/toast.ps1",
    "scripts/toast-action.ps1",
    "scripts/toast-action.vbs",
    "scripts/close-toast.ps1",
    "assets/",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/install-shortcut.ps1"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "approval",
    "window-focus"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanrongbo2006/dsh-window-focus.git"
  },
  "homepage": "https://github.com/fanrongbo2006/dsh-window-focus#readme",
  "bugs": {
    "url": "https://github.com/fanrongbo2006/dsh-window-focus/issues"
  },
  "author": "fanrongbo2006",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
